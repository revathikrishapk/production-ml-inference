name: "classifier"
platform: "onnxruntime_onnx"
max_batch_size: 8

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 4 ]
  }
]

output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [ 3 ]
  }
]

dynamic_batching {}

instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]